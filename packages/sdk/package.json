{
  "name": "ashabi-wallet-sdk",
  "version": "0.4.0",
  "description": "Let an AI agent pay through an Ashabi Wallet contract on NEAR, including HTTP 402 pay-and-retry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "near",
    "ai-agent",
    "http-402",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmydwest/ashabi-wallet.git",
    "directory": "packages/sdk"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
