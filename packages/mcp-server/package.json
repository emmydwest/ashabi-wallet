{
  "name": "ashabi-wallet-mcp",
  "version": "0.2.0",
  "description": "Stdio MCP server that lets an assistant pay through an Ashabi Wallet contract.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ashabi-wallet-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --external:near-api-js --external:@modelcontextprotocol/sdk --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "near-api-js": "^7.4.0",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "ashabi-wallet-sdk": "file:../sdk"
  },
  "keywords": [
    "near",
    "mcp",
    "ai-agent",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmydwest/ashabi-wallet.git",
    "directory": "packages/mcp-server"
  }
}
